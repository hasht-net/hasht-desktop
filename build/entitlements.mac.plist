<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Required because electron-builder.yml sets hardenedRuntime: true. Without
  these, getUserMedia() in a server window silently fails the TCC check in
  any *signed* build (mic/camera just don't work, no error surfaces).

  This only bites at release: unsigned dev builds (npm run start / dev) run
  under Terminal's/Electron's own ad-hoc signature and inherit whatever mic
  permission Terminal already has, so the bug won't reproduce there.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Browser-handoff passkey sign-in owns its keychain and Bluetooth
         access. The shell does not need a restricted keychain access group. -->
  </dict>
</plist>
